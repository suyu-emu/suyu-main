{
  "policy_version": "suyu-package-policy-1",
  "description": "Package-policy validation rules shared by the exporter (src/common/package_policy.cpp) and release tooling (tools/package_policy/scan_release.py). These are project distribution controls: they decide what the project ships and what the exporter copies. They are not license terms, they do not verify ownership, and passing them is not a legal clearance.",
  "notes": [
    "Names are compared case-insensitively after trailing dots and spaces are removed, because Windows ignores both.",
    "Content signatures are checked in addition to names; a renamed file is still caught when its contents match.",
    "tests/package_policy/test_policy_sync.py fails when the C++ tables and this file disagree."
  ],
  "key_file_name_patterns": [
    "^(prod|title|console|dev)\\.keys(_autogenerated)?([._-].*)?$",
    "^(prod|title|console|dev)[._-]?keys(\\.(txt|ini|bak|old|dat))?$",
    "^.*\\.keys$",
    "^keys\\.(txt|ini|dat)$",
    "^(fuses?|tsec(_keys?)?|secure_boot|sbk)\\.(bin|txt|keys)$",
    "^.*\\.tik$"
  ],
  "firmware_nand_name_patterns": [
    "^boot[01](\\.bin)?$",
    "^rawnand(\\.bin)?(\\.\\d+)?$",
    "^prodinfo(f)?(\\.bin)?$",
    "^(safe|system|user)\\.bin$",
    "^bcpkg2-[1-4]-.*$",
    "^package[12](\\.bin)?$",
    "^(firmware|nand)[._-].*\\.(zip|7z|rar|tar)$"
  ],
  "firmware_nand_path_patterns": [
    "(^|/)system/contents/registered(/|$)",
    "(^|/)nand/system(/|$)",
    "(^|/)system/save/80000000000000(43|e1|e2|51|52|53)(/|$)",
    "(^|/)system/tickets(/|$)"
  ],
  "game_container_extensions": [
    ".nsp",
    ".xci",
    ".nsz",
    ".xcz",
    ".nca",
    ".ncz",
    ".nro",
    ".nso",
    ".nax0"
  ],
  "game_export_marker_names": [
    "readme_native_export.txt",
    "game_source.txt",
    "aot_manifest.json",
    "export-package.json",
    ".suyu-export-package.json",
    "recomp_registration.c",
    "recomp_modules.cmake",
    "romfs.bin",
    "control.nca",
    "main.npdm",
    "recomp_gaps.json",
    "suyu-install.txt"
  ],
  "user_data_path_patterns": [
    "(^|/)nand/user/save(/|$)",
    "(^|/)user/save(/|$)",
    "(^|/)cache/shader(/|$)",
    "(^|/)(qt-config|sdl2-config)\\.ini$",
    "(^|/)config/custom/[0-9a-f]{16}\\.ini$",
    "(^|/)profiles\\.dat$",
    "(^|/)(crash_dumps|dump|log)/",
    "\\.dmp$"
  ],
  "content_signatures": [
    {
      "name": "Nintendo PFS0 container (NSP)",
      "offset": 0,
      "hex": "50465330"
    },
    {
      "name": "Nintendo HFS0 partition",
      "offset": 0,
      "hex": "48465330"
    },
    {
      "name": "Nintendo XCI header",
      "offset": 256,
      "hex": "48454144"
    },
    {
      "name": "Nintendo NSO executable",
      "offset": 0,
      "hex": "4e534f30"
    },
    {
      "name": "Nintendo NRO executable",
      "offset": 16,
      "hex": "4e524f30"
    },
    {
      "name": "Nintendo NPDM metadata",
      "offset": 0,
      "hex": "4d455441"
    },
    {
      "name": "Nintendo NAX0 archive",
      "offset": 32,
      "hex": "4e415830"
    },
    {
      "name": "Compressed NCZ section table",
      "offset": 16384,
      "hex": "4e435a534543544e"
    }
  ],
  "key_text_patterns": [
    "(?im)^\\s*(master_key|master_kek|keyblob|keyblob_key|keyblob_mac_key|encrypted_keyblob|titlekek|package1_key|package2_key|key_area_key_(application|ocean|system))_[0-9a-f]{2}\\s*=\\s*[0-9a-f]{32,}",
    "(?im)^\\s*(header_key|header_kek|sd_seed|tsec_key|secure_boot_key|eticket_rsa_kek|eticket_rsa_keypair|eticket_extended_kek|sd_card_kek_source|aes_kek_generation_source|aes_key_generation_source|bis_key_0[0-3])\\s*=\\s*[0-9a-f]{32,}",
    "(?im)^\\s*[0-9a-f]{32}\\s*=\\s*[0-9a-f]{32}\\s*$"
  ],
  "key_text_scan_limit_bytes": 65536,
  "release_layouts": {
