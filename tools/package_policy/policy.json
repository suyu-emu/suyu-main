    ],
    "linux-appimage": [
      "AppRun",
      "\\.DirIcon",
      "suyu\\.(desktop|svg)",
      "usr/bin/(suyu|suyu-cmd|qt\\.conf)",
      "usr/lib/(?:x86_64-linux-gnu/)?lib[A-Za-z0-9_+.-]+\\.so(?:\\.[0-9]+)*",
      "usr/plugins/(platforms|platforminputcontexts|imageformats|iconengines|platformthemes|tls|networkinformation|xcbglintegrations|wayland-shell-integration|wayland-decoration-client|wayland-graphics-integration-client)/lib[A-Za-z0-9_+.-]+\\.so(?:\\.[0-9]+)*",
      "usr/apprun-hooks/[A-Za-z0-9_.-]+\\.sh",
      "usr/share/applications/suyu\\.desktop",
      "usr/share/icons/hicolor/scalable/apps/suyu\\.svg",
      "usr/share/suyu/(appimage-provenance|distribution-sources)\\.json",
      "usr/share/doc/suyu/(LICENSE\\.txt|THIRD-PARTY-NOTICES\\.txt)",
      "usr/share/doc/suyu/LICENSES/[A-Za-z0-9_.+-]+\\.txt",
